# LLM and Multimodal API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Indian Language Speech & Translation (Sarvam AI)
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Fact Check Tools API
FACTCHECK_API_KEY=your_factcheck_api_key_here

# Evidence Search API (Tavily or fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# Database URL (Postgres/Supabase or local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/sach.db

# Server Config
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# WhatsApp Cloud API / Webhook (Optional)
WHATSAPP_VERIFY_TOKEN=sach_verify_token_dev
WHATSAPP_API_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=
